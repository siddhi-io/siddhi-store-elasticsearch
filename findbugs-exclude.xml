    </Match>
    <Match>
        <Class name="io.siddhi.extension.store.elasticsearch.utils.ElasticsearchTableUtils,"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="io.siddhi.extension.store.elasticsearch.utils.ElasticsearchTableUtils"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="io.siddhi.extension.store.elasticsearch.ElasticsearchEventTable$BulkProcessorListener"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
</FindBugsFilter>